# Server-only administrator credentials
YSSCHOOL_ADMIN_PASSWORD=replace-with-a-long-unique-password
YSSCHOOL_SESSION_SECRET=replace-with-at-least-32-random-characters

# Server-only Supabase credentials
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
